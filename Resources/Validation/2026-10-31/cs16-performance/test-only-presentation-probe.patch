+/* Temporary test-only presentation counters. Never staged into the release. */
+static double probe_clock(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec + t.tv_nsec * 1e-9;
+}
+
+static void probe_present(const char *kind, double begin, UINT flags)
+{
+    static __thread double start[2], total[2], longest[2];
+    static __thread unsigned count[2];
+    int n = kind[0] == 's';
+    double end, duration;
+    if (!getenv("GOOSE_WGL_PROBE")) return;
+    end = probe_clock();
+    duration = end - begin;
+    if (!start[n]) start[n] = begin;
+    total[n] += duration;
+    if (duration > longest[n]) longest[n] = duration;
+    count[n]++;
+    if (end - start[n] >= 2.0)
+    {
+        fprintf(stderr, "GOOSE_PRESENT kind=%s now=%.6f seconds=%.6f count=%u fps=%.3f mean_ms=%.3f max_ms=%.3f flags=%#x\n",
+                kind, end, end-start[n], count[n], count[n]/(end-start[n]),
+                total[n]*1000/count[n], longest[n]*1000, flags);
+        start[n]=end; total[n]=longest[n]=0; count[n]=0;
+    }
+}
