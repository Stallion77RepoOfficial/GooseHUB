+static NTSTATUS goose_batch_commands( void *args )
+{
+    struct goose_gl_batch *batch = args;
+    UINT i;
+    NTSTATUS status;
+    if (batch->count > GOOSE_GL_BATCH_CAPACITY) return STATUS_INVALID_PARAMETER;
+    for (i = 0; i < batch->count; i++)
+    {
+        struct goose_gl_command *cmd = &batch->commands[i];
+        switch (cmd->code)
+        {
+        case unix_glBegin: status = wow64_gl_glBegin( cmd->args ); break;
+        case unix_glEnd: status = wow64_gl_glEnd( cmd->args ); break;
+        case unix_glVertex2f: status = wow64_gl_glVertex2f( cmd->args ); break;
+        case unix_glVertex3f: status = wow64_gl_glVertex3f( cmd->args ); break;
+        case unix_glVertex4f: status = wow64_gl_glVertex4f( cmd->args ); break;
+        case unix_glTexCoord1f: status = wow64_gl_glTexCoord1f( cmd->args ); break;
+        case unix_glTexCoord2f: status = wow64_gl_glTexCoord2f( cmd->args ); break;
+        case unix_glTexCoord3f: status = wow64_gl_glTexCoord3f( cmd->args ); break;
+        case unix_glTexCoord4f: status = wow64_gl_glTexCoord4f( cmd->args ); break;
+        case unix_glMultiTexCoord2f: status = wow64_ext_glMultiTexCoord2f( cmd->args ); break;
+        case unix_glMultiTexCoord2fARB: status = wow64_ext_glMultiTexCoord2fARB( cmd->args ); break;
+        case unix_glMultiTexCoord2fSGIS: status = wow64_ext_glMultiTexCoord2fSGIS( cmd->args ); break;
+        case unix_glColor3f: status = wow64_gl_glColor3f( cmd->args ); break;
+        case unix_glColor4f: status = wow64_gl_glColor4f( cmd->args ); break;
+        case unix_glColor4ub: status = wow64_gl_glColor4ub( cmd->args ); break;
+        case unix_glNormal3f: status = wow64_gl_glNormal3f( cmd->args ); break;
+        case unix_glEdgeFlag: status = wow64_gl_glEdgeFlag( cmd->args ); break;
+        case unix_glVertex2fv: status = wow64_gl_glVertex2fv( cmd->args ); break;
+        case unix_glVertex3fv: status = wow64_gl_glVertex3fv( cmd->args ); break;
