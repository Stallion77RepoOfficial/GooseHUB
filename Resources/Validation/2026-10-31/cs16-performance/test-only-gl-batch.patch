+static NTSTATUS goose_flush_gl_batch( struct goose_gl_batch *batch )
+{
+    NTSTATUS status;
+    if (!batch || !batch->count || batch->flushing) return STATUS_SUCCESS;
+    batch->flushing = TRUE;
+    status = WINE_UNIX_CALL( unix_goose_gl_batch, batch );
+    batch->count = 0;
+    batch->flushing = FALSE;
+    return status;
