+/* Query readback can wait for an already submitted chunk independently of
+ * the application's submission thread. One worker per device preserves the
+ * order of result writes and their shared-event values. */
+class QueryResolveWorker {
+public:
+  QueryResolveWorker() : thread_(std::function<void()>([this] {
+    SetThreadDescription(GetCurrentThread(), L"dxmt-d12-query");
+    if (GetEnvironmentVariableA("DXMT_D3D12_QUERY_PRIORITY_HIGH", nullptr, 0))
+      SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    for (;;) {
+      std::function<void()> task;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        condition_.wait(lock, [&] { return stopped_ || !pending_.empty(); });
+        if (pending_.empty()) return;
+        task = std::move(pending_.front());
+        pending_.pop_front();
+      }
+      auto pool = WMT::MakeAutoreleasePool();
+      task();
+    }
+  })) {}
+  ~QueryResolveWorker() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stopped_ = true;
+    }
+    condition_.notify_one();
+    thread_.join();
+  }
+  void submit(std::function<void()> task) {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      pending_.push_back(std::move(task));
+    }
+    condition_.notify_one();
+  }
+private:
+  std::mutex mutex_;
+  std::condition_variable condition_;
+  std::deque<std::function<void()>> pending_;
+  bool stopped_ = false;
+  dxmt::thread thread_;
+};
