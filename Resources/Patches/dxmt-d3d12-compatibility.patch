+bool DxmtD3D12Resource::initialize_backing() {
+  if (is_placed()) return true;
+  if (desc_.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER && !d3d11_resource_) {
+    if (!desc_.Width || desc_.Width > UINT_MAX) return false;
